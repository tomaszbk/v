import CombinedRow
component CombinedCallbacks() {
    computed offset := 5
    View(width: 360, height: 320) {
        Grid(id: "layout", columns: 2, width: 360, height: 180) {
            View(id: "local", width: 170, height: 160) {
                Checkbox(
                    id: "checked",
                    bind.checked: app.checked,
                    on_change: app.record(offset + app.count + (app.checked ? 11 : 22)),
                    on_click: app.click(offset + app.count),
                )
                Button(id: "compound", on_click: app.record(offset + app.count * 2))
                TextInput(id: "input", bind.text: app.message, on_change: app.named)
                Scroll(id: "scroll", on_click: app.click(app.count), on_scroll: app.record(offset + app.count))
                Label() {
                    Run(text: "Niñez", bold: false, weight: 0, letter_spacing: 0)
                }
            }
            View(width: 170, height: 160) {
                Button(text: "Separate")
            }
        }
        Repeater(model: app.rows, key: item.id) {
            CombinedRow(row_id: item.id)
        }
    }
}
