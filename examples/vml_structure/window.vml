import Card
Absolute {
    width: 620 height: 480 background: "#f8fafc"
    Card { id: heading x: 20 y: 20 width: 580 height: 48 }
    TextInput { multiline: false
        id: live_editor x: 20 y: 80 width: 390 height: 36
        bind.text: app.message on_change: app.copied = app.message
    }
    Button { id: reorder x: 430 y: 80 width: 160 height: 36 text: "Reorder" on_tap: app.reorder() }
    Label { x: 20 y: 130 width: 570 height: 30 text: "Count: ${app.count} · Selected: ${app.selected}" }
    Button { id: count x: 20 y: 170 width: 140 height: 36 text: "Increment" on_tap: app.count = app.count + 1 }
    Absolute {
        x: 20 y: 230 width: 570 height: 220
        Repeater {
            model: app.rows key: item.id
            Absolute {
                id: row y: index * 88 width: 570 height: 76 background: "#e2e8f0"
                Label { id: name x: 16 y: 10 width: 300 height: 26 text: item.name }
                TextInput { multiline: false id: edit x: 16 y: 40 width: 300 height: 30 text: item.name }
                Button { id: pick x: 370 y: 20 width: 160 height: 36 text: "Select" on_tap: app.selected = item.id }
                MenuItem { id: select_menu text: "Select row" on_tap: app.select(item.id) }
            }
        }
    }
}
