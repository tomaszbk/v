View() {
    Button(on_tap: app.record(app.count + 1))
    Checkbox(bind.checked: app.checked, on_change: app.record(app.checked ? 11 : 22))
    TextInput(id: "text", bind.text: app.message, on_change: app.named_callback)
    Slider(id: "value", bind.value: app.level, on_change: app.named_callback)
    Checkbox(id: "checked", bind.checked: app.checked, on_change: app.named_callback)
    Switch(id: "active", bind.active: app.active, on_active: app.named_callback)
    Scroll(on_tap: app.named_callback, on_pointer_down: app.named_callback, on_pointer_drag: app.named_callback, on_pointer_up: app.named_callback, on_long_press: app.named_callback, on_swipe_left: app.named_callback, on_link: app.named_callback)
    Scroll(on_tap: app.record(1), on_scroll: app.record(app.count + 2))
    TextInput(on_tap: app.record(3), on_submit: app.record(4), on_pointer_down: app.record(5))
    Button(on_tap: app.count = app.count + 1)
    TextInput(bind.text: app.message)
    TextInput(bind.text: app.message, on_change: app.nil_callback)
    Checkbox(bind.checked: app.checked)
    Button() {
        MenuItem(id: "context", text: "Record", on_tap: app.record(app.count + 6))
    }
    TextInput(bind.text: app.message, on_change: app.record_text(app.message + " café"))
    Button(on_tap: app.choice = .right)
    Button(on_tap: app.nil_callback)
}
