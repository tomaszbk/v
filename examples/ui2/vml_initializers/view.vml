import Value

Absolute(id: "root", width: 300, height: 200) {
    Label(text: app.next_count(), width: app.next_width(), height: 20)
    Value(value: app.next_input())
    Row(width: 100, height: 30) {
        Label(id: "self", width: app.count + 4, flex_grow: 1, text: "width=${self.width}")
    }
    Button(text: "Next", on_click: app.count++)
    Label { Run(text: app.next_run()) }
    Dropdown { Option(text: app.next_option()) }
    View { MenuItem(text: app.next_menu()) }
    Row(width: 100, height: 20) {
        Label(flex_basis: app.next_basis(), flex_shrink: 0, text: "basis")
    }
}
