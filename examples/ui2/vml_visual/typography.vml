Label(
    id: "paragraph",
    width: 240,
    height: 120,
    style: [
        font_size(18),
        weight(600),
        letter_spacing(-0.5),
        line_height(24),
        lines(4),
        foreground("#334155"),
        tabular_figures(true),
    ],
) {
    Run(text: "Árbol y ")
    Run(
        text: "niñez 123 ",
        style: [
            font_size(12),
            weight(400),
            letter_spacing(0),
            line_height(0),
            line_height_factor(1.5),
            baseline_offset(3),
            foreground("#000000"),
            tabular_figures(false),
        ],
    )
    Run(text: "comparten wrapping y baseline.", style: [italic(true)])
}
