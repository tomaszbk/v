Button(
    id: "styled",
    text: "Tap",
    width: 120,
    height: 40,
    on_click: app.click(),
    style: [
        background("#ffffff"),
        transparent(true),
        radius(8),
        border_width(2),
        border_color("#123456"),
        border_left_color("#000000"),
        border_pattern(dashed),
        dash_length(5),
        dash_gap(3),
        outline_color("#334155"),
        outline_width(1),
        outline_offset(2),
        hover([background("#000000"), transparent(false), foreground("#ffffff")]),
        focus([border_left(0), outline_width(3)]),
        pressed([background("#22c55e")]),
        disabled([background("#cccccc"), foreground("#000000")]),
    ],
)
