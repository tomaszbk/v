Screen(background: "#f1f5f9") {
    Absolute(transparent: true, width: 760, height: 540) {
        ScaledContent(
            id: "canvas",
            x: 20,
            y: 20,
            width: 720,
            height: 500,
            content_width: 720,
            content_height: 500,
            background: "#ffffff",
        ) {
            Absolute(width: 720, height: 500) {
                Label(x: 24, y: 20, width: 660, height: 65, font_size: 28, weight: 700, lines: 2, line_height: 34) {
                    Run(text: "Compiled ")
                    Run(text: "VML", color: "#2563eb", weight: 900)
                    Run(text: " · niñez y canción", size: 18, bold: false, baseline_offset: 2)
                }
                Row(x: 24, y: 105, width: 660, height: 70, gap: 16) {
                    Button(
                        id: "tap",
                        text: "Tap ${app.count}",
                        width: 180,
                        height: 60,
                        flex_grow: 1,
                        radius: 8,
                        border_width: 2,
                        border_color: "#2563eb",
                        hover_background: "#dbeafe",
                        pressed_background: "#93c5fd",
                        on_tap: app.tap(),
                    )
                    TextInput(
                        id: "name",
                        bind.text: app.name,
                        on_submit: app.submit(),
                        width: 220,
                        height: 60,
                        flex_grow: 2,
                        radius: 8,
                        border_width: 1,
                        border_color: "#94a3b8",
                        focus_outline_width: 2,
                        focus_outline_color: "#2563eb",
                    )
                }
                Grid(x: 24, y: 210, width: 660, height: 240, columns: 3, rows: 2, spacing: 16) {
                    Label(
                        text: "Flex comparte espacio; Grid conserva spans.",
                        column_span: 2,
                        font_size: 22,
                        lines: 3,
                        background_color: "#dbeafe",
                    )
                    Label(text: "01", tabular_figures: true, weight: 800, font_size: 40, align: center)
                    Label(text: "02", tabular_figures: true, weight: 800, font_size: 40, align: center)
                    Label(text: "03", tabular_figures: true, weight: 800, font_size: 40, align: center)
                    Label(text: "04", tabular_figures: true, weight: 800, font_size: 40, align: center)
                }
            }
        }
    }
}
